<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      CloneKu palette (Clipku navy).
      Flat navy family built around the Clipku brand colour #243370.
      No gradients anywhere: every surface is a single flat colour, in both
      the dark theme this app ships and the system light appearance.
      Text colours are picked for contrast on the dark navy background:
      on-surface ~13:1, accent ~7:1, on-surface-variant ~8:1.
    -->

    <!-- Brand -->
    <color name="cloneku_navy">#243370</color>
    <color name="cloneku_navy_dark">#1B274F</color>
    <color name="cloneku_navy_deep">#10182E</color>

    <!-- Surfaces: darker navies, stepping up with elevation -->
    <color name="cloneku_surface">#1B274F</color>
    <color name="cloneku_surface_container">#232F57</color>
    <color name="cloneku_surface_container_high">#2C3B6B</color>
    <color name="cloneku_surface_container_highest">#37487F</color>

    <!-- Glass layers: 60% opacity over the navy base -->
    <color name="cloneku_glass">#991B274F</color>
    <color name="cloneku_glass_strong">#CC1B274F</color>

    <!-- Accent: light periwinkle-navy, readable on the deep navy base -->
    <color name="cloneku_accent">#8FA8F0</color>
    <color name="cloneku_accent_dim">#6B84D6</color>
    <color name="cloneku_on_accent">#10182E</color>

    <!-- Text -->
    <color name="cloneku_on_surface">#E9EBF5</color>
    <color name="cloneku_on_surface_variant">#A9B4D6</color>
    <color name="cloneku_outline">#5F6E9E</color>
    <color name="cloneku_outline_variant">#2E3A61</color>

    <!-- Alert -->
    <color name="cloneku_danger">#FF2D55</color>
    <color name="cloneku_on_danger">#690005</color>

    <!-- Warning label (risk badge di daftar aplikasi) — kuning gelap, terbaca di tema gelap maupun terang -->
    <color name="warning_text">#E8A100</color>

    <!--
      Legacy aliases. Layouts inherited from upstream still reference these
      names; remapping them onto the CloneKu palette avoids touching every
      layout at once.
    -->
    <color name="primary">@color/cloneku_navy</color>
    <color name="primary_dark">@color/cloneku_navy_deep</color>
    <color name="primary_light">@color/cloneku_surface_container_high</color>
    <color name="accent">@color/cloneku_accent</color>
    <color name="primary_text">@color/cloneku_on_surface</color>
    <color name="secondary_text">@color/cloneku_on_surface_variant</color>
    <color name="white">#FFFFFFFF</color>

</resources>
