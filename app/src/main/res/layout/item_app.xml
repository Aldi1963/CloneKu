<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

    <!-- Flat navy tile with a navy rim light; the icon floats inside it -->
    <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/cloneku_app_tile"
            android:padding="8dp">

        <ImageView
                android:id="@+id/icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center" />

        <com.othershe.cornerlabelview.CornerLabelView
                android:id="@+id/cornerLabel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:visibility="invisible"
                app:bg_color="@color/cloneku_navy"
                app:position="left_top"
                app:side_length="22dp"
                app:text="XP"
                app:text_color="@color/cloneku_on_surface"
                app:text_size="8sp" />
    </FrameLayout>

    <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="@color/cloneku_on_surface"
            android:textSize="11sp" />

</LinearLayout>
