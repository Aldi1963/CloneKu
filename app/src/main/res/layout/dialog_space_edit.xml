<?xml version="1.0" encoding="utf-8"?>
<!--
  Edit-space dialog: rename the current clone space and pick one of the
  built-in icons. The icon grid is wired up in MainActivity.showEditSpaceDialog;
  each option carries its index in android:tag and isSelected marks the choice.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/space_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/space_name_hint"
        android:inputType="textCapSentences"
        android:maxLength="20"
        android:maxLines="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/space_icon_title"
        android:textColor="@color/cloneku_on_surface"
        android:textSize="14sp" />

    <GridLayout
        android:id="@+id/space_icon_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3"
        android:rowCount="2">

        <LinearLayout
            android:tag="0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="fill_horizontal"
            android:layout_columnWeight="1"
            android:background="@drawable/space_icon_option"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_view"
                android:tint="@color/cloneku_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/space_icon_general"
                android:textColor="@color/cloneku_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="fill_horizontal"
            android:layout_columnWeight="1"
            android:background="@drawable/space_icon_option"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="@color/cloneku_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/space_icon_work"
                android:textColor="@color/cloneku_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="fill_horizontal"
            android:layout_columnWeight="1"
            android:background="@drawable/space_icon_option"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@color/cloneku_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/space_icon_personal"
                android:textColor="@color/cloneku_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="fill_horizontal"
            android:layout_columnWeight="1"
            android:background="@drawable/space_icon_option"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_slideshow"
                android:tint="@color/cloneku_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/space_icon_game"
                android:textColor="@color/cloneku_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="fill_horizontal"
            android:layout_columnWeight="1"
            android:background="@drawable/space_icon_option"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_share"
                android:tint="@color/cloneku_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/space_icon_social"
                android:textColor="@color/cloneku_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="fill_horizontal"
            android:layout_columnWeight="1"
            android:background="@drawable/space_icon_option"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="@color/cloneku_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/space_icon_media"
                android:textColor="@color/cloneku_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

    </GridLayout>

</LinearLayout>
