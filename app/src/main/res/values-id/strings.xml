    <!-- Peringatan risiko clone (item 3 + item 7). Rumusan sengaja tidak
         pasti ("kemungkinan"/"risiko") — bukan kepastian untuk aplikasi
         yang belum diuji. -->
    <string name="clone_risk_payment_label">Kemungkinan ditolak — cek Play Integrity</string>
    <string name="clone_risk_messaging_label">Risiko akun ditangguhkan</string>
    <string name="clone_risk_both_label">Kemungkinan ditolak • Risiko ditangguhkan</string>
    <string name="clone_risk_payment_title">Aplikasi bank / pembayaran</string>
    <string name="clone_risk_messaging_title">Aplikasi pesan</string>
    <string name="clone_risk_whatsapp_title">Clone WhatsApp?</string>
    <string name="clone_risk_both_title">Clone aplikasi ini?</string>
    <string name="clone_risk_payment_message">%1$s adalah aplikasi bank atau pembayaran. Aplikasi seperti ini sering memeriksa Play Integrity / integritas perangkat dan kemungkinan menolak berjalan di dalam clone. Ini hanya kemungkinan — CloneKu belum menguji aplikasi ini secara khusus, dan bisa saja tetap berjalan normal. Bila aplikasi menolak login atau menampilkan galat keamanan, biasanya tidak ada perbaikan dari sisi CloneKu.</string>
    <string name="clone_risk_whatsapp_message">Akun WhatsApp yang berjalan di dalam clone berisiko ditangguhkan oleh WhatsApp. Jangan pakai nomor utama Anda untuk WhatsApp hasil clone bila kehilangan akun itu akan bermasalah. Gunakan dengan risiko sendiri.</string>
    <string name="clone_risk_messaging_message">%1$s adalah aplikasi pesan. Akun yang berjalan di dalam clone berisiko ditangguhkan oleh penyedia layanan. Gunakan dengan risiko sendiri.</string>
    <string name="clone_risk_continue">Tetap clone</string>

