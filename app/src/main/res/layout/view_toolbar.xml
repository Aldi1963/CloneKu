<?xml version="1.0" encoding="utf-8"?>

<!--
  Transparent so the flat navy background runs behind the title. Title uses
  Space Grotesk, subtitle (the clone space name) uses the mono label
  treatment.
-->
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ToolBarColorStyle"
        app:subtitleTextAppearance="@style/CloneKu.LabelMono.Accent"
        app:subtitleTextColor="@color/cloneku_accent"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/CloneKu.Toolbar.Title"
        app:titleTextColor="@color/cloneku_on_surface">

</com.google.android.material.appbar.MaterialToolbar>
