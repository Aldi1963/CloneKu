    <!-- Trek B: clone risk warnings (item 3 + item 7). Wording is deliberately
         uncertain ("may"/"risk") — never a certainty for an untested app. -->
    <string name="clone_risk_payment_label">May be rejected — Play Integrity check</string>
    <string name="clone_risk_messaging_label">Account suspension risk</string>
    <string name="clone_risk_both_label">May be rejected • Suspension risk</string>
    <string name="clone_risk_payment_title">Banking / payment app</string>
    <string name="clone_risk_messaging_title">Messaging app</string>
    <string name="clone_risk_whatsapp_title">Clone WhatsApp?</string>
    <string name="clone_risk_both_title">Clone this app?</string>
    <string name="clone_risk_payment_message">%1$s is a banking or payment app. Such apps often check Play Integrity / device integrity and may refuse to run inside a cloned environment. This is only a possibility — CloneKu has not tested this exact app, and it may work fine. If it refuses to log in or shows a security error, there is usually no fix from CloneKu\'s side.</string>
    <string name="clone_risk_whatsapp_message">WhatsApp accounts running in a cloned environment risk being suspended by WhatsApp. Do not use your primary number for a cloned WhatsApp if losing that account would be a problem. Use it at your own risk.</string>
    <string name="clone_risk_messaging_message">%1$s is a messaging app. Accounts running in a cloned environment risk being suspended by the service provider. Use it at your own risk.</string>
    <string name="clone_risk_continue">Clone anyway</string>

