    <!-- Migration warning from MaxCloner (fix 1.0.1) -->
    <string name="migration_title">Old clones do not carry over</string>
    <string name="migration_message">CloneKu is a new app, separate from MaxCloner. Clones you made in MaxCloner live in the old app data and cannot be moved automatically — Android does not let one app read another app data, and MaxCloner has no backup feature.\n\nRecreate the clones you need in CloneKu by tapping the + button.</string>
    <string name="empty_title">No clones yet</string>
    <string name="empty_hint">Tap the + button to clone an app.\n\nClones you made in MaxCloner do not carry over to CloneKu — recreate them here.</string>

    <!-- "New in 1.0.0" tour (fix 1.0.1) -->
    <string name="whats_new_title">New in 1.0.0</string>
    <string name="whats_new_message">CloneKu 1.0.0 brings:\n\n• Long-press a clone → Back up data / Restore data: save a clone data to a ZIP file and restore it later.\n\n• Tap the space name in the toolbar → change the space name and icon (e.g. Work, Personal).\n\n• Risk labels on the app picker screen: banking and payment apps that use Play Integrity are marked “Likely to be rejected” before cloning.</string>
    <string name="whats_new_summary">Show the 1.0.0 new-features tour again</string>
