<?xml version="1.0" encoding="utf-8"?>
<!--
  Space icon option in the edit-space dialog. Selected state gets a flat
  navy fill with an accent border; unselected is transparent with a faint
  outline. No gradients.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cloneku_navy" />
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="@color/cloneku_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="@color/cloneku_outline_variant" />
        </shape>
    </item>
</selector>
