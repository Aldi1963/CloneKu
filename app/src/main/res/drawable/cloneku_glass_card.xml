<?xml version="1.0" encoding="utf-8"?>
<!--
  Flat navy surface with a 1px outline.
  Radius is 4dp: the spec calls for a crisp, technical shape language rather
  than the pill shapes Material 3 defaults to.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/cloneku_glass" />
    <corners android:radius="4dp" />
    <stroke
        android:width="1dp"
        android:color="@color/cloneku_outline_variant" />
</shape>
