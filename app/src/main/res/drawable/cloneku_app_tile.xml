<?xml version="1.0" encoding="utf-8"?>
<!--
  App instance tile. Flat navy fill with a faint navy rim so icons read as
  sitting on a surface rather than floating on the raw background.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/cloneku_glass" />
    <corners android:radius="4dp" />
    <stroke
        android:width="1dp"
        android:color="@color/cloneku_accent_dim" />
</shape>
